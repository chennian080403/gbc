#!/bin/zsh
# gbc：给 Grok Bot 用的「前台 Claude 会话」遥控器。
# 一次调用完成 发话 → 等 Claude 做完 → 取回回复，省掉多轮来回。
#
#   gbc open [目录] [启动命令]   开 screen 会话并弹出 Terminal 窗口给人看（默认 ~/Documents、$GBC_LAUNCH 或 claude）
#   gbc send "文字" [最长等待秒]  发一条消息；等到 Claude 做完或超时（默认 60 秒），打印它的回复
#   gbc send -n "文字"           只发不等，立刻返回
#   gbc reply [条数]             打印 Claude 最近的回复（默认最近 1 轮）
#   gbc wait [最长等待秒]         等 Claude 当前这一轮做完再打印回复
#   gbc busy                     Claude 在干活输出 yes，空闲输出 no
#   gbc esc                      按一次 Esc（打断 Claude）
#   gbc show                     重新弹出 Terminal 窗口挂上会话
#   gbc close                    结束会话
#   gbc ctx                      打印本会话上下文占比（窗口按 100 万 token 算）
#   gbc jj                       交接换新对话：写交接 → /clear → 让新对话读交接接着干
#   gbc cl A jj                  额度用完的应急：用 A 号额度写交接、切到 A 号新对话并接着干（B 号同理；要 GBC_CL=1）
#   gbc cl A                     只切到 A 号开空白新对话
#   gbc doctor [--full]          自检装好没有；--full 另开临时会话实测一轮收发
#   gbc version                  打印版本
# send 这一轮做完时，上下文到 GBC_CTX_LIMIT（默认 28）% 就自动 gbc jj，全在脚本里算，不经过任何模型；
# 不想自动换就设 GBC_AUTO_JJ=0，只在结果末尾提示。
# 会话名可用环境变量 GBC_SESSION 改，默认 gb-claude。
# 系统自带的 screen 4.00 截屏会丢中文，所以回复内容读 Claude 的对话记录，屏幕只用来判断忙不忙。
#
# 配置（环境变量，或写进 ~/.config/gbc/config.zsh，每次运行都会读）：
#   GBC_LAUNCH       开会话的启动命令，默认 claude
#   GBC_JJ_CMD       交接脚本，收一个会话 id、输出「交接文件：<路径>（…」；不设就让 Claude 自己写交接
#   GBC_HANDOFF_DIR  内置交接写到哪，默认 ~/交接
#   GBC_CL           装了多号接力（/cla /clb）才设 1
#   GBC_CTX_WINDOW   模型上下文窗口 token 数，默认 1000000；20 万窗口的模型要设 200000
#   GBC_CTX_LIMIT    自动交接的占比线，默认 28
#   GBC_PROJECTS     Claude 对话记录目录，默认 $CLAUDE_CONFIG_DIR/projects 或 ~/.claude/projects

GBC_VERSION=1.0
CONF=${GBC_CONFIG:-$HOME/.config/gbc/config.zsh}
[[ -f $CONF ]] && source "$CONF"
export GBC_PROJECTS=${GBC_PROJECTS:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects}
S=${GBC_SESSION:-gb-claude}
TMP=${TMPDIR:-/tmp}/gbc.$S
mkdir -p "$TMP"
DIR=$(cat "$TMP/dir" 2>/dev/null || echo "$HOME/Documents")

alive() { screen -ls 2>/dev/null | grep -q "[0-9]\.${S}[[:space:]]" }
need()  { alive || { echo "没有名为 $S 的会话，先 gbc open"; exit 1 } }

snap() {
  rm -f "$TMP/screen"
  screen -S "$S" -p 0 -X hardcopy "$TMP/screen" 2>/dev/null
  sleep 0.05
  { LC_ALL=C tr -c '\n -~' ' ' < "$TMP/screen" } 2>/dev/null
}

# 忙的时候底部有「Tinkering… (16s)」这种动词进度行（… 截屏后变成 &），老版本是 esc to interrupt
is_busy() { snap | tail -n 15 | grep -qE '^.? ?[A-Z][a-z]+ing(&|\.\.\.)?( \(|$)|esc to interrupt' }
# 输入框底栏出来了、且不在忙，才算能收消息（刚启动时既不忙也没就绪）
is_ready() { local s=$(snap | tail -n 15); print -r -- "$s" | grep -qE 'shift\+tab to cycle|for shortcuts' && ! print -r -- "$s" | grep -qE '^.? ?[A-Z][a-z]+ing(&|\.\.\.)?( \(|$)' }
# 新目录第一次开 Claude 会问信不信任这个目录。默认选项不一定是「信任」，不能替人按回车，只提示
is_trust() { snap | grep -qE 'trust (the files in )?this folder|Yes, proceed|Yes, I trust' }
wait_ready() {
  local i
  for i in {1..120}; do
    is_ready && return 0
    is_trust && { echo "—— Claude 在问信不信任这个目录：到终端窗口选「Yes, I trust this folder」，再重发 ——"; return 1 }
    sleep 0.25
  done
  echo "—— 30 秒内 Claude 没就绪，先 gbc show 看一眼 ——"; return 1
}
# 从别的 Claude 会话里继承来的这些变量会让新 Claude 不存对话记录，开会话前去掉
CLEAN_ENV=(-u CLAUDECODE -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_MESSAGING_SOCKET -u CLAUDE_CODE_MESSAGING_TOKEN -u CLAUDE_CODE_EXECPATH -u CLAUDE_CODE_SESSION_ATTENDED -u CLAUDE_PID -u CLAUDE_EFFORT -u AI_AGENT)

show_window() {
  osascript -e "tell application \"Terminal\" to do script \"screen -x $S\"" -e 'tell application "Terminal" to activate' >/dev/null
}

# 读本会话的对话记录：第一次发话后按「含这句原文」找到自己的那份并记下，同目录开着别的 Claude 也不会读错
# since（毫秒）非空就取那之后的轮次，否则取最近 n 轮
get_reply() {
  python3 - "$DIR" "${1:-}" "${2:-1}" "$TMP/file" "$TMP/msg" "${3:-}" <<'EOF'
import json, os, re, sys, glob, datetime
d, since, n, keep, msgf, mode = sys.argv[1:7]
n = int(n)
proj = os.path.join(os.path.expanduser(os.environ['GBC_PROJECTS']), re.sub(r'[^A-Za-z0-9]', '-', os.path.realpath(d)))
f = open(keep).read().strip() if os.path.exists(keep) else ''
if not os.path.exists(f):
    msg = open(msgf, encoding='utf-8').read() if os.path.exists(msgf) else ''
    # 同一句话可能在别的会话里发过，所以要「原文相同且发在这次 send 之后」
    def mine(c):
        for line in open(c, encoding='utf-8'):
            if msg and '"user"' in line and json.dumps(msg, ensure_ascii=False)[1:-1] in line:
                o = json.loads(line); ts = o.get('timestamp', '')
                if (o.get('message') or {}).get('content') == msg and ts and since and \
                   datetime.datetime.fromisoformat(ts.replace('Z', '+00:00')).timestamp() * 1000 >= int(since) - 2000:
                    return True
        return False
    cands = sorted(glob.glob(proj + '/*.jsonl'), key=os.path.getmtime, reverse=True)
    f = next((c for c in cands[:20] if mine(c)), '')
    if not f: sys.exit(1 if mode else print('（还没找到本会话的对话记录，Claude 可能还没收到这条）'))
    open(keep, 'w').write(f)
turns, cur, ctx = [], None, 0
for line in open(f, encoding='utf-8'):
    try: o = json.loads(line)
    except Exception: continue
    ts = o.get('timestamp')
    ms = int(datetime.datetime.fromisoformat(ts.replace('Z', '+00:00')).timestamp() * 1000) if ts else 0
    m = o.get('message') or {}
    if o.get('type') == 'user' and isinstance(m.get('content'), str) and not m['content'].lstrip().startswith(('<local-command', '<command-')):
        cur = {'ms': ms, 'ask': m['content'], 'say': [], 'done': False}; turns.append(cur)
    elif o.get('subtype') == 'turn_duration' and cur is not None:
        cur['done'] = True
    elif o.get('type') == 'assistant' and cur is not None:
        u = m.get('usage') or {}
        ctx = u.get('input_tokens', 0) + u.get('cache_read_input_tokens', 0) + u.get('cache_creation_input_tokens', 0) or ctx
        for c in m.get('content') or []:
            if c.get('type') == 'text' and c['text'].strip(): cur['say'].append(c['text'].strip())
            elif c.get('type') == 'tool_use': cur['say'].append('［调用 %s］' % c.get('name'))
pick = [t for t in turns if t['ms'] >= int(since) - 2000] if since else turns[-n:]
pct = ctx * 100 / int(os.environ.get('GBC_CTX_WINDOW') or 1000000)
if mode == 'ctx': sys.exit(print('%.0f' % pct))
if mode: sys.exit(0 if pick and pick[-1]['done'] else 1)
for t in pick:
    print('▶ 发：' + t['ask'][:200])
    print('\n'.join(t['say']) or '（还没有回复）')
    print()
print('［上下文 %.0f%%］' % pct)
EOF
}

# 以对话记录里这一轮的 turn_duration 为准；屏幕判断只做兜底（先忙过、再闲 1 秒）
wait_done() {
  local max=$1 since=$2 t=0 seen=0 idle=0
  while (( t < max * 10 )); do
    [[ -n $since ]] && get_reply "$since" 1 done 2>/dev/null && { get_reply "$since"; return 0 }
    if is_busy; then seen=1; idle=0
    else
      (( idle++ ))
      (( seen && idle >= 4 )) && { get_reply "$since"; return 0 }
    fi
    sleep 0.25; (( t += 3 ))
  done
  get_reply "$since"
  echo "—— 等了 ${max} 秒 Claude 还在干，稍后 gbc wait 或 gbc reply ——"
  return 1
}

# 写交接 → /clear → 让新对话读交接接着干
do_jj() {
  local f out h
  f=$(cat "$TMP/file" 2>/dev/null); [[ -f $f ]] || { echo "本会话还没发过话，没有可交接的记录"; return 1 }
  echo "写交接中（约 1 分钟）…"
  if [[ -n $GBC_JJ_CMD ]]; then
    out=$(env $CLEAN_ENV ${~GBC_JJ_CMD} "${f:t:r}" 2>&1)
    h=$(print -r -- "$out" | sed -n 's/^交接文件：\(.*\)（.*/\1/p' | tail -1)
  else
    # 没有交接脚本：让 Claude 自己写到指定路径，写没写成看文件在不在
    local hd=${~GBC_HANDOFF_DIR:-$HOME/交接}
    mkdir -p "$hd"; h=$hd/$(date +%Y-%m-%d-%H%M)-gbc-$S.md
    local s0=$(now_ms)
    type_line "上下文快满了，要换新对话。请把交接写到 $h ：先读哪些文件、硬约束、现状、按顺序的待办（每条写清怎么做、怎么验收），让新对话看着就能直接开干。写完只回这个路径。"
    out=$(wait_done 300 "$s0")
  fi
  [[ -f $h ]] || { print -r -- "$out" | tail -5; echo "交接没写成，没有清空对话"; return 1 }
  echo "交接文件：$h"
  type_line "/clear"; sleep 1.5; wait_ready || return 1
  rm -f "$TMP/file"
  local since=$(now_ms)
  type_line "请读 $h ，按里面的交接方案继续做。"
  wait_done "${1:-120}" "$since"
}

# 这一轮做完且上下文到线，就自动交接
auto_jj() {
  local pct=$(get_reply "" 1 ctx 2>/dev/null)
  [[ -n $pct ]] && (( pct >= ${GBC_CTX_LIMIT:-28} )) && [[ ${GBC_AUTO_JJ:-1} == 1 ]] || {
    [[ -n $pct ]] && (( pct >= ${GBC_CTX_LIMIT:-28} )) && echo "上下文已到 ${pct}%，该 gbc jj 了"; return 0 }
  echo "—— 上下文 ${pct}% 到线，自动交接换新对话 ——"
  do_jj
}

now_ms() { python3 -c 'import time;print(int(time.time()*1000))' }

# 粘贴一段文字并回车；走 screen 的寄存器粘贴，中文和特殊字符不会被 stuff 转义吃掉
type_line() {
  print -rn -- "$1" > "$TMP/msg"
  screen -S "$S" -p 0 -X readreg p "$TMP/msg"
  screen -S "$S" -p 0 -X paste p
  sleep 0.2
  screen -S "$S" -p 0 -X stuff $'\r'
}

case $1 in
  open)
    dir=${2:-$HOME/Documents}; cmd=${3:-${GBC_LAUNCH:-claude}}
    if alive; then echo "会话 $S 已存在，直接挂窗口"; else
      rm -f "$TMP/file"
      env $CLEAN_ENV screen -U -dmS "$S" zsh -ic "cd ${(q)dir} && $cmd; exec zsh -i"
      print -r -- "$dir" > "$TMP/dir"
    fi
    show_window
    wait_ready && echo "已开：会话 $S，目录 $dir，Claude 已就绪" ;;
  send)
    need; nowait=0
    [[ $2 == -n ]] && { nowait=1; shift }
    text=$2; max=${3:-60}
    [[ -z $text ]] && { echo "用法：gbc send \"文字\""; exit 1 }
    wait_ready || exit 1
    since=$(now_ms)
    type_line "$text"
    (( nowait )) && { echo "已发出"; exit 0 }
    wait_done "$max" "$since" && auto_jj ;;
  wait)  need; wait_done "${2:-120}" "" ;;
  reply) get_reply "" "${2:-1}" ;;
  ctx)   need; get_reply "" 1 ctx ;;
  jj)    need; wait_ready && do_jj "${2:-120}" ;;
  cl)
    [[ $GBC_CL == 1 ]] || { echo "没装切号工具（多号接力的 /cla /clb），gbc cl 不可用；装了在 $CONF 里设 GBC_CL=1"; exit 1 }
    need; acct=${2:l}; mode=$3
    [[ $acct == [a-z] && ( -z $mode || $mode == jj ) ]] || { echo "用法：gbc cl A [jj]"; exit 1 }
    clip0=$(pbpaste 2>/dev/null)
    type_line "/cl$acct${mode:+ $mode}"
    if [[ $mode == jj ]]; then
      # cl-switch 写完交接会把「请读 …」复制到剪贴板，再在同一个终端里换号重开 Claude
      echo "用 ${(U)acct} 号写交接中（约 1–2 分钟）…"
      for i in {1..300}; do
        clip=$(pbpaste 2>/dev/null)
        [[ $clip != "$clip0" && $clip == 请读* ]] && break
        sleep 1
      done
      [[ $clip == 请读* && $clip != "$clip0" ]] || { echo "5 分钟没等到交接写好，看 ~/.config/cl/log/jj.log"; exit 1 }
      echo "交接：$clip"
    fi
    sleep 4; wait_ready || exit 1
    rm -f "$TMP/file"
    echo "已切到 ${(U)acct} 号新对话"
    [[ $mode == jj ]] && exec "$0" send "$clip" "${4:-120}" ;;
  busy)  need; is_busy && echo yes || echo no ;;
  esc)   need; screen -S "$S" -p 0 -X stuff $'\e'; echo "已按 Esc" ;;
  show)  need; show_window ;;
  close) need; screen -S "$S" -X quit; rm -rf "$TMP"; echo "已结束 $S" ;;
  version) echo "gbc $GBC_VERSION" ;;
  doctor)
    bad=0
    chk() { if eval "$2" >/dev/null 2>&1; then echo "✅ $1"; else echo "❌ $1 —— $3"; bad=1; fi }
    echo "gbc $GBC_VERSION，配置文件：$([[ -f $CONF ]] && echo $CONF || echo 没有，全用默认值)"
    chk "screen" "command -v screen" "macOS 自带；找不到就 brew install screen"
    chk "python3" "command -v python3" "装命令行工具：xcode-select --install"
    l=${GBC_LAUNCH:-claude}
    chk "启动命令 $l" "env $CLEAN_ENV zsh -ic 'whence ${l%% *}'" "先装 Claude Code（npm install -g @anthropic-ai/claude-code）；用别的启动命令就设 GBC_LAUNCH"
    chk "对话记录目录 $GBC_PROJECTS" "[[ -d $GBC_PROJECTS ]]" "先手动跑一次 claude；记录不在默认位置就设 GBC_PROJECTS"
    chk "能控制 Terminal" "osascript -e 'tell application \"Terminal\" to count windows'" "系统设置 → 隐私与安全性 → 自动化，允许它控制「终端」"
    if [[ -n $GBC_JJ_CMD ]]; then chk "交接脚本 $GBC_JJ_CMD" "[[ -x ${~GBC_JJ_CMD} ]]" "路径不对，或者删掉 GBC_JJ_CMD 改用内置交接"
    else echo "✅ 交接：内置（让 Claude 自己写到 ${GBC_HANDOFF_DIR:-~/交接}）"; fi
    [[ $GBC_CL == 1 ]] && echo "✅ 切号：gbc cl 可用" || echo "ℹ️  切号：没开（GBC_CL 不是 1），额度用完只能等恢复"
    echo "ℹ️  上下文窗口按 ${GBC_CTX_WINDOW:-1000000} token 算，到 ${GBC_CTX_LIMIT:-28}% 自动交接；模型窗口是 20 万的要设 GBC_CTX_WINDOW=200000"
    sl=$(pmset -g 2>/dev/null | awk '$1=="sleep"{print $2}')
    [[ $sl == 0 ]] && echo "✅ 插电不睡眠" || echo "⚠️  插电 ${sl} 分钟后会睡，睡着时 Grok Bot 连不上这台 Mac：系统设置里关掉自动睡眠，或常开 caffeinate -s"
    if [[ $2 == --full ]] && (( ! bad )); then
      echo "—— 实测一轮（临时会话 gbc-doctor，在 ~/Documents 开，会弹一个终端窗口，约 1 分钟）——"
      export GBC_SESSION=gbc-doctor GBC_AUTO_JJ=0
      sf=${TMPDIR:-/tmp}/gbc-doctor.seen; rm -f "$sf"
      "$0" close >/dev/null 2>&1
      "$0" open "$HOME/Documents" || { echo "❌ 会话没开起来，到弹出的终端窗口看卡在哪（首次用要先登录 Claude、信任目录）"; exit 1 }
      ( for i in {1..240}; do [[ $("$0" busy 2>/dev/null) == yes ]] && { touch "$sf"; break }; sleep 0.25; done ) &
      out=$("$0" send "从 1 数到 30，用逗号隔开，只回这串数字，不要用任何工具。" 120)
      kill $! 2>/dev/null; wait $! 2>/dev/null; seen=no; [[ -f $sf ]] && seen=yes; rm -f "$sf"
      [[ $out == *30* ]] && echo "✅ 收发：拿回了 Claude 的回复" || { echo "❌ 收发：没拿到回复，输出如下"; print -r -- "$out"; bad=1 }
      [[ $seen == yes ]] && echo "✅ 忙闲识别：认出了 Claude 在干活" || echo "⚠️  忙闲识别：没认出「在干活」，Claude Code 可能改了界面；收发仍以对话记录为准"
      "$0" close >/dev/null
    fi
    (( bad )) && { echo "有 ❌ 的先按提示修，修完再跑 gbc doctor"; exit 1 }
    echo "都好了。下一步：gbc open <目录>，再 gbc send \"任务\"" ;;
  *) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
